# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN commit file .env yang berisi kredensial asli.

DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/API

# Wajib: string acak panjang. Buat dengan:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=ganti-dengan-string-acak-panjang

# Masa berlaku access token (menit)
JWT_EXPIRES_MINUTES=60
